{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Doctor Operation",
  "type": "object",
  "required": ["schema_version", "id", "operation", "status", "started_at"],
  "properties": {
    "schema_version": { "const": "0.3.4" },
    "id": { "type": "string" },
    "operation": { "type": "string" },
    "status": { "enum": ["started", "in_progress", "completed", "failed", "rolled_back", "needs_recovery"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}

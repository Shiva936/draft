{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/submit-record.schema.json",
  "title": "Draft Submit Record",
  "type": "object",
  "required": [
    "schema_version", "id", "pack_id", "actor_id", "native_submit_status",
    "hook_status", "overall_status", "message_ref", "hook_results",
    "hook_receipt_refs", "object_refs", "event_refs", "risk_level",
    "risk_receipt_id", "started_at", "ended_at", "record_digest",
    "failure_reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^rcp_[A-Za-z0-9_-]+$" },
    "pack_id": { "type": "string", "pattern": "^pck_[A-Za-z0-9_-]+$" },
    "actor_id": { "type": "string", "pattern": "^act_[A-Za-z0-9_-]+$" },
    "native_submit_status": { "enum": ["submitted", "failed"] },
    "hook_status": { "enum": ["not_configured", "skipped", "succeeded", "failed"] },
    "overall_status": { "enum": ["submitted", "failed", "submitted_with_hook_failure"] },
    "message_ref": { "type": "string" },
    "hook_results": { "type": "array", "items": { "$ref": "#/$defs/hook_result" } },
    "hook_receipt_refs": { "type": "array", "items": { "type": "string", "pattern": "^rcp_[A-Za-z0-9_-]+$" } },
    "object_refs": { "type": "array", "items": { "type": "string" } },
    "event_refs": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "string" },
    "risk_receipt_id": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^rcp_[A-Za-z0-9_-]+$" }] },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "record_digest": { "$ref": "#/$defs/digest" },
    "failure_reason": { "type": ["string", "null"] }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hook_result": {
      "type": "object",
      "required": [
        "hook_name", "hook_phase", "shell", "working_dir", "command_hash",
        "exit_code", "stdout_ref", "stderr_ref", "started_at", "ended_at", "env_keys"
      ],
      "properties": {
        "hook_name": { "type": "string" },
        "hook_phase": { "type": "string" },
        "shell": { "type": "string" },
        "working_dir": { "type": "string" },
        "command_hash": { "$ref": "#/$defs/digest" },
        "exit_code": { "type": "integer" },
        "stdout_ref": { "type": "string" },
        "stderr_ref": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "env_keys": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$id": "https://draft.dev/schemas/console-http.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ActionInputField": {
      "additionalProperties": false,
      "description": "One declared input of an action.",
      "properties": {
        "help": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable machine identity: the key the client submits and the server validates. Never a label.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ActionInputKind"
        },
        "label": {
          "description": "Human label. Presentation only.",
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "required"
      ],
      "type": "object"
    },
    "ActionInputKind": {
      "description": "The shape of one action input.\n\nDeliberately small and semantic. A frontend maps these to whatever controls suit it — a Web form, a TUI prompt — but neither invents an input Draft did not declare, and neither decides what is valid.",
      "oneOf": [
        {
          "description": "Free text, optionally bounded.",
          "properties": {
            "max_length": {
              "default": null,
              "format": "uint32",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "enum": [
                "text"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "One of a server-supplied set. The set is part of the input contract, so a client holding a stale set cannot invoke against it.",
          "properties": {
            "options": {
              "items": {
                "$ref": "#/definitions/SelectOption"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "select"
              ],
              "type": "string"
            }
          },
          "required": [
            "options",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A true/false flag.",
          "properties": {
            "type": {
              "enum": [
                "boolean"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An explicit acknowledgement, which must be `true` to proceed.",
          "properties": {
            "type": {
              "enum": [
                "confirmation"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ActionPresentation": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "disabled_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "expires_at_unix_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "input_contract_digest": {
          "default": "",
          "description": "Digest of `inputs`, carried into the invocation capability so a stale input contract cannot be replayed.",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "description": "What this action needs from the caller. Empty means it takes nothing, and supplying anything is then an error.\n\nThis is one contract serving two purposes: a frontend renders it, and `draftd` validates against it. The frontend's checks are a convenience; the server's are the decision.",
          "items": {
            "$ref": "#/definitions/ActionInputField"
          },
          "type": "array"
        },
        "invocation_capability": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/definitions/ActionTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the action acts on, when it is something other than the subject."
        }
      },
      "required": [
        "action_id",
        "enabled",
        "label",
        "requires_confirmation"
      ],
      "type": "object"
    },
    "ActionTarget": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ActionTargetKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "ActionTargetKind": {
      "description": "What an action acts on, beyond the subject that produced it.\n\nGeneric on purpose: a target is a kind and an id, so a new kind of extension-contributed action needs no new frontend code and no new scope.",
      "enum": [
        "extension",
        "extension_source",
        "pending_authorization",
        "grant"
      ],
      "type": "string"
    },
    "ApiErrorBodyDto": {
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ApiFailureDto": {
      "properties": {
        "error": {
          "$ref": "#/definitions/ApiErrorBodyDto"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "error",
        "schema_version"
      ],
      "type": "object"
    },
    "AssigneeRefDto": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "CanonicalRevisions": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "registry": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "registry"
      ],
      "type": "object"
    },
    "CapabilityGapDto": {
      "description": "A capability nothing installed can supply.\n\nNever names a package: Draft reports what is missing, and does not advertise on any publisher's behalf.",
      "properties": {
        "capability": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "resource_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "capability",
        "reason"
      ],
      "type": "object"
    },
    "ChangeDerivationGapDto": {
      "description": "Something Draft could not determine about a transition.\n\nRendered in its own section, never mixed in with the changes: a gap means \"unknown\", and showing it beside real changes would read as \"unchanged\".",
      "properties": {
        "kind": {
          "description": "`presence_uncertain` or `absence_uncertain`.",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceLocatorDto"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resource_id": {
          "type": "string"
        },
        "uncovered_side": {
          "description": "Which side of the comparison was not covered.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resource_id",
        "uncovered_side"
      ],
      "type": "object"
    },
    "ChangeSummaryDto": {
      "properties": {
        "change_id": {
          "type": "string"
        },
        "import_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "intent": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": true,
        "submit_state": {
          "type": "string"
        },
        "valid_actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "change_id",
        "intent",
        "name",
        "submit_state",
        "valid_actions"
      ],
      "type": "object"
    },
    "ChangeViewDto": {
      "description": "A Change's authoritative transition, plus any derived explanation of it.",
      "properties": {
        "base_snapshot_digest": {
          "type": "string"
        },
        "capability_gaps": {
          "default": [],
          "items": {
            "$ref": "#/definitions/CapabilityGapDto"
          },
          "type": "array"
        },
        "change_set_digest": {
          "type": "string"
        },
        "derivation_gaps": {
          "default": [],
          "description": "What could not be determined. A separate field on purpose.",
          "items": {
            "$ref": "#/definitions/ChangeDerivationGapDto"
          },
          "type": "array"
        },
        "observation_context_digest": {
          "type": "string"
        },
        "resources": {
          "description": "What changed, proved.",
          "items": {
            "$ref": "#/definitions/ResourceChangeDto"
          },
          "type": "array"
        },
        "result_snapshot_digest": {
          "type": "string"
        },
        "review_units": {
          "default": [],
          "description": "Contributed review units, when a comparison capability derived any. Absent means Draft knows *that* the resources changed without being able to say how — a real answer, not an empty rendering.",
          "items": {
            "$ref": "#/definitions/ReviewUnitDto"
          },
          "type": "array"
        }
      },
      "required": [
        "base_snapshot_digest",
        "change_set_digest",
        "observation_context_digest",
        "resources",
        "result_snapshot_digest"
      ],
      "type": "object"
    },
    "ClassificationBundleDto": {
      "description": "What classes a project's resources carry.",
      "properties": {
        "assigned": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "classification_digest": {
          "type": "string"
        },
        "collisions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gaps": {
          "default": [],
          "description": "Present when nothing is installed to classify anything. Distinguishes \"classified, and nothing matched\" from \"nothing can classify\".",
          "items": {
            "$ref": "#/definitions/CapabilityGapDto"
          },
          "type": "array"
        }
      },
      "required": [
        "assigned",
        "classification_digest",
        "collisions"
      ],
      "type": "object"
    },
    "ConsoleActionInvocation": {
      "additionalProperties": false,
      "properties": {
        "application_session_id": {
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "expected_revisions": {
          "$ref": "#/definitions/CanonicalRevisions"
        },
        "invocation_capability": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "application_session_id",
        "expected_revisions",
        "invocation_capability",
        "operation_id"
      ],
      "type": "object"
    },
    "ConsoleNavigationSection": {
      "additionalProperties": false,
      "description": "One entry in a scope's navigation, with the views nested under it.\n\nNested rather than flattened because §8.3 nests: `Work (Tasks | Changes)` is one section with two views, and flattening it would make Tasks and Changes look like peers of Resources and Baselines. A section with no children is a leaf and renders as one row.",
      "properties": {
        "children": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "ConsoleReadModel": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/definitions/ActionPresentation"
          },
          "type": "array"
        },
        "content": true,
        "evidence_links": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "freshness": {
          "$ref": "#/definitions/ModelFreshness"
        },
        "health": {
          "type": "string"
        },
        "navigation": {
          "items": {
            "$ref": "#/definitions/ConsoleNavigationSection"
          },
          "type": "array"
        },
        "next_safe_actions": {
          "items": {
            "$ref": "#/definitions/NextSafeAction"
          },
          "type": "array"
        },
        "operation_links": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "permission_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "read_only": {
          "type": "boolean"
        },
        "revisions": {
          "$ref": "#/definitions/CanonicalRevisions"
        },
        "subject": {
          "$ref": "#/definitions/ConsoleSubject"
        }
      },
      "required": [
        "actions",
        "content",
        "evidence_links",
        "freshness",
        "health",
        "navigation",
        "next_safe_actions",
        "operation_links",
        "read_only",
        "revisions",
        "subject"
      ],
      "type": "object"
    },
    "ConsoleScope": {
      "oneOf": [
        {
          "enum": [
            "GLOBAL",
            "PROJECT",
            "CHANGE"
          ],
          "type": "string"
        },
        {
          "description": "One accepted Baseline. §8.3 gives it its own scope because its views — the three roots, lineage, composition, recoverability — are about a historical node, not about the project as it stands now.",
          "enum": [
            "BASELINE"
          ],
          "type": "string"
        }
      ]
    },
    "ConsoleSessionDto": {
      "properties": {
        "authenticated": {
          "type": "boolean"
        },
        "csrf_token": {
          "type": "string"
        },
        "preselected_workspace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "authenticated",
        "csrf_token",
        "schema_version"
      ],
      "type": "object"
    },
    "ConsoleSubject": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "default": null,
          "description": "Required by, and only meaningful for, the `BASELINE` scope.\n\nAlways serialized, like the sibling ids: a subject that sometimes carries the field and sometimes omits it is two shapes on the wire.",
          "type": [
            "string",
            "null"
          ]
        },
        "change_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/definitions/ConsoleScope"
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "scope"
      ],
      "type": "object"
    },
    "DiscoveredExtensionDto": {
      "properties": {
        "catalog_id": {
          "type": "string"
        },
        "freshness": {
          "$ref": "#/definitions/ExtensionCatalogUsabilityDto"
        },
        "source_id": {
          "type": "string"
        },
        "target": {
          "$ref": "#/definitions/ExtensionCatalogTargetDto"
        }
      },
      "required": [
        "catalog_id",
        "freshness",
        "source_id",
        "target"
      ],
      "type": "object"
    },
    "ExtensionCatalogLocationDto": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "local_directory"
              ],
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "https"
              ],
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "type": "object"
        }
      ]
    },
    "ExtensionCatalogSourceDto": {
      "properties": {
        "builtin": {
          "description": "Built-in sources come from the build's official bootstrap. They can be disabled, but their trust anchor is not the user's to edit.",
          "type": "boolean"
        },
        "catalog_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "configured_at": {
          "type": "string"
        },
        "enabled": {
          "description": "A disabled source is not searched, refreshed or installed from. Its configuration, trust and installed packages are all untouched.",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_refreshed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "$ref": "#/definitions/ExtensionCatalogLocationDto"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "builtin",
        "configured_at",
        "enabled",
        "id",
        "location",
        "schema_version"
      ],
      "type": "object"
    },
    "ExtensionCatalogSourceStatusDto": {
      "properties": {
        "cached_package_count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "configured": {
          "type": "boolean"
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/definitions/ExtensionCatalogSourceDto"
        },
        "trusted": {
          "type": "boolean"
        },
        "usability": {
          "$ref": "#/definitions/ExtensionCatalogUsabilityDto"
        }
      },
      "required": [
        "cached_package_count",
        "configured",
        "source",
        "trusted",
        "usability"
      ],
      "type": "object"
    },
    "ExtensionCatalogTargetDto": {
      "properties": {
        "artifact_path": {
          "type": "string"
        },
        "draft_api": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "length": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "publisher": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "draft_api",
        "id",
        "length",
        "publisher",
        "sha256",
        "version"
      ],
      "type": "object"
    },
    "ExtensionCatalogUsabilityDto": {
      "enum": [
        "untrusted",
        "usable",
        "expired",
        "invalid",
        "unavailable"
      ],
      "type": "string"
    },
    "InboxItemDto": {
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "next_action",
        "status",
        "subject_id"
      ],
      "type": "object"
    },
    "ModelFreshness": {
      "enum": [
        "loading",
        "fresh",
        "stale",
        "partial",
        "unavailable"
      ],
      "type": "string"
    },
    "NextSafeAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "reason"
      ],
      "type": "object"
    },
    "ProjectSummaryDto": {
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/definitions/ChangeSummaryDto"
          },
          "type": "array"
        },
        "inbox": {
          "items": {
            "$ref": "#/definitions/InboxItemDto"
          },
          "type": "array"
        },
        "project": {
          "$ref": "#/definitions/RegistryProjectDto"
        },
        "revision": {
          "$ref": "#/definitions/WorkspaceRevisionDto"
        },
        "status": true,
        "tasks": {
          "items": {
            "$ref": "#/definitions/TaskDefinitionDto"
          },
          "type": "array"
        }
      },
      "required": [
        "changes",
        "inbox",
        "project",
        "revision",
        "status",
        "tasks"
      ],
      "type": "object"
    },
    "RegistryProjectDto": {
      "properties": {
        "created_at": {
          "type": "string"
        },
        "draft_version": {
          "type": "string"
        },
        "health": {
          "type": "string"
        },
        "last_seen_at": {
          "type": "string"
        },
        "last_workspace_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "location_revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "project_path": {
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "storage_path": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "draft_version",
        "health",
        "last_seen_at",
        "location_revision",
        "name",
        "project_path",
        "schema_version",
        "storage_path",
        "workspace_id"
      ],
      "type": "object"
    },
    "ResourceChangeDto": {
      "description": "One resource's transition, as the Console renders it.",
      "properties": {
        "after_state_digest": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "aspects": {
          "description": "Neutral aspect names: `added`, `removed`, `content_changed`, `metadata_changed`, `relocated`, `form_changed`, `attributes_changed`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "before_state_digest": {
          "default": null,

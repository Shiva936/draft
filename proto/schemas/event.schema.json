{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/event.schema.json",
  "title": "Draft Event Record",
  "type": "object",
  "required": [
    "schema_version", "ledger", "event_id", "type", "time", "subject_id",
    "actor_id", "candidate_id", "previous_event_hash", "event_hash",
    "receipt_id", "metadata"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "ledger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "workspace_id"],
          "properties": {
            "kind": { "const": "workspace" },
            "workspace_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "ledger_id"],
          "properties": {
            "kind": { "const": "system" },
            "ledger_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" },
    "type": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "subject_id": { "type": ["string", "null"] },
    "actor_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": ["string", "null"] },
    "previous_event_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "event_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "receipt_id": { "type": ["string", "null"] },
    "metadata": {}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Project State",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_hash",
    "checks",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "workspace_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$id": "https://draft.dev/schemas/project-state.schema.json"
}

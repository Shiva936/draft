{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/candidate-profile.schema.json",
  "title": "Draft Candidate Profile",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "kind",
    "capabilities",
    "limits",
    "source",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["agent", "command", "manual", "human"] },
    "command": { "type": ["string", "null"] },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "limits": { "$ref": "#/$defs/limits" },
    "source": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "capabilities": {
      "type": "object",
      "properties": {
        "can_plan": { "type": "boolean" },
        "can_edit": { "type": "boolean" },
        "can_run_tests": { "type": "boolean" },
        "can_read_index": { "type": "boolean" },
        "can_accept_task_contract": { "type": "boolean" },
        "supports_resume": { "type": "boolean" },
        "supports_streaming_logs": { "type": "boolean" },
        "supports_patch_output": { "type": "boolean" },
        "supports_pack_output": { "type": "boolean" },
        "requires_shell": { "type": "boolean" },
        "requires_network": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_runtime_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "max_files_changed": { "type": ["integer", "null"], "minimum": 0 },
        "max_changed_lines": { "type": ["integer", "null"], "minimum": 0 },
        "max_processes": { "type": ["integer", "null"], "minimum": 0 },
        "max_output_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "network": { "enum": ["denied", "local", "full"] },
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "env_allowlist": { "type": "array", "items": { "type": "string" } },
        "command_allowlist": { "type": "array", "items": { "type": "string" } },
        "isolation_mode": { "enum": ["isolated", "in_place"] }
      },
      "additionalProperties": false
    }
  }
}

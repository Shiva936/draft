{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/decision-record.schema.json",
  "title": "Draft Decision",
  "x-draft-format-revision": 1,
  "description": "One immutable judgement about one exact ChangeRevision. A Decision authorizes a promotion; it never performs one, and it never carries to another revision.",
  "type": "object",
  "required": ["id", "revision", "outcome", "decided_by", "decided_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^dec_[A-Za-z0-9_-]+$" },
    "revision": {
      "description": "The exact revision judged. Backed by a create-once digest binding, so 'the same revision' means the same bytes.",
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9_-]+$"
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "decided_by": { "type": "string", "pattern": "^act_[A-Za-z0-9_-]+$" },
    "decided_at": { "type": "integer" },
    "authority": {
      "description": "The exact grants that permitted this decision. Empty is legitimate for a rejection — refusing work needs no authority beyond being asked to review it — but an approval citing none is refused.",
      "type": "array",
      "items": { "$ref": "#/$defs/security_fact_ref" }
    }
  },
  "$defs": {
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["outcome"],
          "additionalProperties": false,
          "properties": { "outcome": { "const": "approved" } }
        },
        {
          "type": "object",
          "required": ["outcome", "reason"],
          "additionalProperties": false,
          "properties": {
            "outcome": { "const": "rejected" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["outcome", "reason"],
          "additionalProperties": false,
          "properties": {
            "outcome": { "const": "changes_requested" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "security_fact_ref": {
      "type": "object",
      "required": ["kind", "digest"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "logical_id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}

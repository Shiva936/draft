{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Decision Record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "decision_type",
    "pack_id",
    "base_stable_head",
    "author",
    "reason",
    "evidence_ids",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^dec_[A-Za-z0-9_-]+$"
    },
    "decision_type": {
      "enum": [
        "approve",
        "reject",
        "waive",
        "override",
        "accept_risk",
        "request_changes",
        "invalidate"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pack_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evd_[A-Za-z0-9_-]+$"
      }
    },
    "receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_stable_head": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "invalidation_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$id": "https://draft.dev/schemas/decision-record.schema.json"
}

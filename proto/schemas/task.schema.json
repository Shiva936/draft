{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Task Definition",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "template",
    "goal",
    "allowed_zones",
    "forbidden_zones",
    "success_criteria",
    "risk",
    "mode",
    "required_evidence",
    "review_questions",
    "candidate_preset",
    "schedule",
    "parent_pack",
    "source_context",
    "created_at",
    "updated_at",
    "created_by",
    "base_stable_head",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "0.3.4" },
    "id": { "type": "string", "pattern": "^tsk_[A-Za-z0-9_-]+$" },
    "name": { "type": "string" },
    "kind": { "enum": ["defined", "inline", "imported", "generated"] },
    "template": { "type": ["string", "null"] },
    "goal": { "type": "string" },
    "allowed_zones": { "type": "array" },
    "forbidden_zones": { "type": "array" },
    "success_criteria": { "type": "array" },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "mode": { "enum": ["normal", "safe", "plan_first"] },
    "required_evidence": { "type": "array" },
    "review_questions": { "type": "array" },
    "candidate_preset": { "type": ["string", "null"] },
    "schedule": { "type": ["object", "null"] },
    "parent_pack": { "type": ["string", "null"] },
    "source_context": { "type": ["object", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "created_by": { "type": "string" },
    "base_stable_head": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}

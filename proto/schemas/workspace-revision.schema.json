{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Workspace Revision",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_id",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$id": "https://draft.dev/schemas/workspace-revision.schema.json"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/change-quarantine.schema.json",
  "title": "Draft Change Quarantine Record",
  "type": "object",
  "required": [
    "schema_version", "change_id", "revision_id", "revision_digest",
    "storage_location", "source", "artifact_digest", "trust_evaluation",
    "quarantined_at", "promoted_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^chg_[A-Za-z0-9_-]+$" },
    "revision_id": { "type": "string", "pattern": "^rev_[A-Za-z0-9_-]+$" },
    "revision_digest": { "$ref": "#/$defs/digest" },
    "storage_location": { "enum": ["quarantine", "store"] },
    "source": { "type": "string" },
    "artifact_digest": { "$ref": "#/$defs/digest" },
    "trust_evaluation": { "enum": ["quarantined", "verified", "approved", "rejected", "promoted"] },
    "quarantined_at": { "type": "string", "format": "date-time" },
    "promoted_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

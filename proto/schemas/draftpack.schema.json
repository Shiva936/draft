{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/draftpack.schema.json",
  "title": "Draftpack Header",
  "type": "object",
  "required": [
    "schema_version", "format", "draft_version", "artifact_digest",
    "pack_id", "name", "exported_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "format": { "const": "draftpack" },
    "draft_version": { "type": "string", "minLength": 1 },
    "artifact_digest": { "$ref": "#/$defs/digest" },
    "pack_id": { "type": "string", "pattern": "^pck_[A-Za-z0-9_-]+$" },
    "name": { "type": "string" },
    "exported_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

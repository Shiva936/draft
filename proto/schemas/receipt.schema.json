{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/receipt.schema.json",
  "title": "Draft Signed Receipt",
  "type": "object",
  "required": [
    "schema_version", "receipt_id", "event_type", "subject_id", "actor_id",
    "candidate_id", "workspace_id", "workspace_hash", "event_hash",
    "previous_event_hash", "timestamp", "policy_version", "draft_version",
    "signature_algorithm", "public_key_id", "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "pattern": "^rcp_[A-Za-z0-9_-]+$" },
    "event_type": { "type": "string", "minLength": 1 },
    "subject_id": { "type": ["string", "null"] },
    "actor_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": ["string", "null"] },
    "workspace_id": { "type": "string", "minLength": 1 },
    "workspace_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "event_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "previous_event_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "policy_version": { "type": "string" },
    "draft_version": { "type": "string", "minLength": 1 },
    "signature_algorithm": { "const": "Ed25519" },
    "public_key_id": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Waiver",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "pack_id",
    "finding_id",
    "author",
    "reason",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^wvr_[A-Za-z0-9_-]+$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^pck_[A-Za-z0-9_-]+$"
    },
    "finding_id": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_id": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false,
  "$id": "https://draft.dev/schemas/waiver.schema.json"
}

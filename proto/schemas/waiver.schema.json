{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Waiver",
  "type": "object",
  "required": ["schema_version", "id", "pack_id", "finding_id", "author", "reason", "expires_at"],
  "properties": {
    "schema_version": { "const": "0.3.4" },
    "id": { "type": "string", "pattern": "^wvr_[A-Za-z0-9_-]+$" },
    "pack_id": { "type": "string", "pattern": "^pck_[A-Za-z0-9_-]+$" },
    "finding_id": { "type": "string" },
    "author": { "type": "string" },
    "reason": { "type": "string" },
    "expires_at": { "type": "string" }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/pack.schema.json",
  "title": "Draft Pack Manifest",
  "type": "object",
  "required": [
    "schema_version", "pack_id", "manifest_digest", "name", "description",
    "intent", "provenance", "author_id", "candidate_id", "declared_dependencies", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "pattern": "^pck_[A-Za-z0-9_-]+$" },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "intent": {
      "enum": ["feature", "bugfix", "refactor", "security", "migration", "docs", "test-only", "dependency-update", "cleanup", "generated"]
    },
    "provenance": { "type": "object" },
    "author_id": { "type": "string" },
    "candidate_id": { "type": ["string", "null"] },
    "declared_dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

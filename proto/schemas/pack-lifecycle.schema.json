{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Pack Lifecycle",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "revision_id",
    "revision_digest",
    "lifecycle",
    "updated_at",
    "last_operation_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "pack_id": {
      "type": "string"
    },
    "revision_id": {
      "type": "string"
    },
    "revision_digest": {
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "verified",
        "reviewing",
        "approved",
        "rejected",
        "submitted"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_operation_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$id": "https://draft.dev/schemas/pack-lifecycle.schema.json"
}

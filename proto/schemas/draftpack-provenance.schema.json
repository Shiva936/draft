{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/draftpack-provenance.schema.json",
  "title": "Draftpack Provenance",
  "type": "object",
  "required": [
    "schema_version", "origin", "exported_by_actor",
    "source_workspace_hash", "external_receipt_ids"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "origin": { "type": "string" },
    "exported_by_actor": { "type": "string" },
    "source_workspace_hash": { "$ref": "#/$defs/digest" },
    "external_receipt_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^rcp_[A-Za-z0-9_-]+$" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

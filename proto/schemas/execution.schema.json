{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Task Execution",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "task_id",
    "candidate",
    "status",
    "attempt",
    "previous_attempt",
    "command",
    "base_baseline",
    "parent_change",
    "produced_change",
    "evidence_ids",
    "receipt_ids",
    "started_at",
    "finished_at",
    "cancellation_reason",
    "failure_reason",
    "workspace_id",
    "pid",
    "stdout_ref",
    "stderr_ref",
    "exit_code",
    "verification_result",
    "scope_result",
    "risk_result"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^exe_[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^tsk_[A-Za-z0-9_-]+$"
    },
    "candidate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "cancelled",
        "interrupted",
        "retrying",
        "completed",
        "failed"
      ]
    },
    "attempt": {
      "type": "integer"
    },
    "previous_attempt": {
      "type": [
        "string",
        "null"
      ]
    },
    "command": {
      "type": "array"
    },
    "base_baseline": {
      "type": "string"
    },
    "parent_change": {
      "type": [
        "string",
        "null"
      ]
    },
    "produced_change": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array"
    },
    "receipt_ids": {
      "type": "array"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancellation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stdout_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "stderr_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "verification_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "scope_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "risk_result": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$id": "https://draft.dev/schemas/execution.schema.json"
}

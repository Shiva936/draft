{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Evidence State",
  "type": "object",
  "required": ["schema_version", "id", "kind", "state", "produced_at"],
  "properties": {
    "schema_version": { "const": "0.3.4" },
    "id": { "type": "string", "pattern": "^evd_[A-Za-z0-9_-]+$" },
    "task_id": { "type": ["string", "null"] },
    "pack_id": { "type": ["string", "null"] },
    "execution_id": { "type": ["string", "null"] },
    "kind": { "type": "string" },
    "state": { "enum": ["fresh", "stale", "missing", "failed", "waived", "running", "not_applicable"] },
    "produced_at": { "type": "string" }
  },
  "additionalProperties": true
}

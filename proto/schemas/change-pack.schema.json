{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/change-pack.schema.json",
  "title": "Draft ChangePack Manifest",
  "type": "object",
  "required": [
    "schema_version", "change_pack_id", "manifest_digest", "name", "description",
    "intent", "provenance", "author_id", "candidate_id", "declared_dependencies", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "change_pack_id": { "type": "string", "pattern": "^cpk_[A-Za-z0-9_-]+$" },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "intent": {
      "description": "A namespaced intent id from a contributed vocabulary, or Draft's own 'draft.core/unspecified'. Draft stores and compares intents; it never interprets one, so this is deliberately not a closed enum of one domain's vocabulary.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 256
    },
    "provenance": { "type": "object" },
    "author_id": { "type": "string" },
    "candidate_id": { "type": ["string", "null"] },
    "declared_dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

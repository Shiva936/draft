{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/extension-authorization.schema.json",
  "title": "Draft Extension Authorization Grant",
  "$ref": "#/$defs/grant",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "permission": { "enum": ["process.execute"] },
    "artifact": {
      "type": "object",
      "required": ["extension_id", "publisher", "package_version", "content_hash"],
      "properties": {
        "extension_id": { "type": "string", "pattern": "^[a-z0-9._-]{1,64}$" },
        "source_id": { "type": "string" },
        "publisher": { "type": "string", "minLength": 1 },
        "package_version": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "required": [
        "schema_version", "artifact", "permissions", "actor_id",
        "decision_id", "operation_id", "decided_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "artifact": { "$ref": "#/$defs/artifact" },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permission" }
        },
        "actor_id": { "type": "string", "pattern": "^act_[A-Za-z0-9_-]+$" },
        "decision_id": { "type": "string", "minLength": 1 },
        "operation_id": { "type": "string", "pattern": "^op_[A-Za-z0-9_-]+$" },
        "decided_at": { "type": "string", "format": "date-time" },
        "superseded_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft StateEvidenceRoot entries",
  "type": "object",
  "required": [
    "schema_version",
    "entries",
    "state_evidence_root"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "enum": [
              "resource",
              "relation"
            ]
          },
          "resource_id": {
            "type": "string",
            "pattern": "^res_[A-Za-z0-9_-]+$"
          },
          "state": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "primary": {
            "type": "object",
            "required": [
              "id",
              "digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^obs_[A-Za-z0-9_-]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "corroborating": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "digest"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^obs_[A-Za-z0-9_-]+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "enum": [
                    "relation_record",
                    "state_bearing_declaration"
                  ]
                },
                "record": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "declaration": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "state_evidence_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$id": "https://draft.dev/schemas/state-evidence-entry.schema.json"
}

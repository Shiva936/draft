{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.dev/schemas/pack-lock.schema.json",
  "title": "Draft Pack Lock",
  "type": "object",
  "required": [
    "schema_version", "pack_id", "workspace_hash", "file_hashes",
    "policy_version", "risk_engine_version", "verification_commands",
    "lsif_version", "test_selector_version", "fuzz_selector_version",
    "dependency_pack_hashes", "receipt_digests"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "pattern": "^pck_[A-Za-z0-9_-]+$" },
    "workspace_hash": { "$ref": "#/$defs/digest" },
    "file_hashes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "policy_version": { "type": "string" },
    "risk_engine_version": { "type": "string" },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "command_hash"],
        "properties": {
          "command": { "type": "string" },
          "command_hash": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "lsif_version": { "type": "string" },
    "test_selector_version": { "type": "string" },
    "fuzz_selector_version": { "type": "string" },
    "dependency_pack_hashes": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
    "receipt_digests": { "type": "array", "items": { "$ref": "#/$defs/digest" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

{
  "rules": [
    {
      "code": "draft.language.go/dependency-lockfile",
      "weight": 4,
      "when": {
        "condition": "resources_matching",
        "predicate": {
          "predicate": "raw",
          "of": {
            "predicate": "path_glob",
            "glob": "**/go.sum"
          }
        },
        "at_least": 1
      },
      "explanation": "a dependency lockfile changed"
    }
  ]
}

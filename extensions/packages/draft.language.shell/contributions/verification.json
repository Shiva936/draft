{
  "checks": [
    {
      "check_id": "draft.language.shell/lint",
      "display_name": "ShellCheck",
      "applies_to": {
        "predicate": "has_class",
        "class_id": "draft.language.shell/source"
      },
      "requirement": "optional",
      "selection": "whole",
      "operation": {
        "request_contract": {
          "schema_id": "draft.core/verification-request",
          "revision": 1
        },
        "response_contract": {
          "schema_id": "draft.core/verification-result",
          "revision": 1
        },
        "max_response_bytes": 1048576,
        "executor": {
          "kind": "command",
          "command": {
            "program": "shellcheck",
            "args": [
              "-S",
              "style"
            ]
          }
        }
      }
    }
  ]
}
